# Copy to /arogya/apps/leave-app/.env and fill in secrets:
#   cp deploy/env.production.example .env

# --- PostgreSQL (dedicated leave-app DB; do not reuse arogyadeploy postgres) ---
POSTGRES_DB=leave_management
POSTGRES_USER=leave_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5434

# Leave empty to use the local postgres service above
DATABASE_URL=
DB_SSL=false

# --- Ports bound to 127.0.0.1 only (host Nginx proxies public traffic) ---
BACKEND_PORT=5001
FRONTEND_PORT=3300

# --- Auth / CORS ---
JWT_SECRET=CHANGE_ME_MIN_32_CHAR_RANDOM_SECRET
FRONTEND_URL=https://leave-app.arogya.life

# Must match public domain — baked into frontend at image build time
VITE_API_URL=https://leave-app.arogya.life/api
VITE_SHOW_DEMO_CREDENTIALS=false

# Optional: override image names (defaults match Docker Hub)
# BACKEND_IMAGE=abishekmukunthan/arogya-leave-backend:latest
# FRONTEND_IMAGE=abishekmukunthan/arogya-leave-frontend:latest
