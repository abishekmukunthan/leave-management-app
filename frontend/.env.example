# Backend API Base URL deployed on Railway
# Example: https://stunning-vision-production.up.railway.app/api
VITE_API_URL=

# Demo Credentials visibility on Login Page (false in production, true only for local testing)
VITE_SHOW_DEMO_CREDENTIALS=false

# Session storage driver: localStorage (default, keeps login across browser restarts) or sessionStorage
VITE_SESSION_STORAGE_TYPE=localStorage
