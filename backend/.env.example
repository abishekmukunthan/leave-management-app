# Server Environment
PORT=5001
NODE_ENV=production

# Supabase Hosted Database Connection String (Production)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Local PostgreSQL Configuration (Fallback when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leave_management
DB_USER=postgres
DB_PASSWORD=postgres

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend CORS Allowed Origin (Cloudflare Pages URL)
# Example: https://leave-management-frontend.pages.dev
FRONTEND_URL=
