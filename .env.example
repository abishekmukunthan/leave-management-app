# ==============================================================================
# Arogya Leave Management System - Docker Environment Configuration
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local PostgreSQL Container Configuration (Used by 'postgres' service)
# ------------------------------------------------------------------------------
POSTGRES_DB=leave_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. External Database / Production Override (Optional)
# If set, the backend connects using this URL instead of the local PostgreSQL container.
# Example (Supabase): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=
# Set DB_SSL=false for local non-SSL PostgreSQL, or true / require for hosted SSL databases
DB_SSL=false

# ------------------------------------------------------------------------------
# 3. Backend Service Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=5001
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# CORS allowed origins for backend (comma-separated if multiple)
# For local Docker Compose: http://localhost,http://localhost:80
# For production: https://leave.arogya.com
FRONTEND_URL=http://localhost,http://localhost:80,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Frontend Service Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=80

# URL where the user's BROWSER reaches the backend API.
# Local Docker: http://localhost:5001/api (or /api if using Nginx reverse proxy)
# Production: https://api.arogya.com/api
VITE_API_URL=http://localhost:5001/api

# Show quick-fill demo credentials on the Login page (false in production)
VITE_SHOW_DEMO_CREDENTIALS=false
